<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>NetcdfSharp.ucar</RootNamespace>
    <AssemblyName>NetcdfSharp.Core</AssemblyName>
    <PackageId>NetcdfSharp.Core</PackageId>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0672;CS0809</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="nc2/NCdumpW.cs" />
    <Compile Remove="nc2/iosp/netcdf3/N3iosp.cs" />
    <Compile Remove="unidata/io/RemoteRandomAccessFile.cs" />
    <Compile Remove="unidata/io/MMapRandomAccessFile.cs" />
    <Compile Remove="nc2/util/DiskCache.cs" />
    <Compile Remove="nc2/util/DiskCache2.cs" />
    <Compile Remove="nc2/util/CompareNetcdf2.cs" />
    <Compile Remove="nc2/util/ListenerManager.cs" />
    <Compile Remove="unidata/geoloc/vertical/**" />
    <Compile Remove="nc2/units/DateUnit.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow the test project to access internal members, mirroring how the Java tests
         (which live in package ucar.ma2) can access package-private members. -->
    <InternalsVisibleTo Include="NetcdfSharp.Tests" />
  </ItemGroup>

</Project>